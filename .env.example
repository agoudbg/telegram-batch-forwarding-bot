# Telegram MTProto credentials
API_ID=
API_HASH=
BOT_TOKEN=

# Optional StringSession. SESSION_FILE keeps the connected session in ./data.
SESSION=
SESSION_FILE=./data/session.txt

# The web page, API and media endpoints share this origin.
# Change it before building if the app will be reached at another address.
PUBLIC_ORIGIN=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000

# Exact proxy socket IPs (comma-separated); empty ignores forwarding headers.
# The trusted proxy must overwrite X-Forwarded-For with one client IP.
# See docs/DEPLOYMENT.md for Docker gateway and host proxy configuration.
TRUSTED_PROXY_IPS=

# Docker maps this host port to the server container's port 3000.
TBFB_PORT=3000
TBFB_UID=1000
TBFB_GID=1000

# Server-side secret used to derive share-scoped public ids.
SANITIZE_SECRET=

# Bot username without @, used in links and unhosted-media fallback buttons.
BOT_USERNAME=
MINIAPP_SHORT_NAME=

# Project-local persistent data.
DATA_DIR=./data

# Docker runs the server and bot as separate services, so set one stable secret
# for both services. `pnpm start` can still generate one for local development.
INTERNAL_MEDIA_SECRET=
INTERNAL_MEDIA_HOST=127.0.0.1

# Silence window for forward batching, in milliseconds.
BATCH_SILENCE_MS=10000

# Set to 1 to use Telegram test servers with separate test credentials and data.
TELEGRAM_TEST_SERVER=
